Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
AddType audio/mpeg .mp3
AddType image/webp .webp

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Certificate checks must be able to reach the site over plain HTTP.
  RewriteRule ^\.well-known/ - [L]

  # One address only: browser data belongs to the exact address, so ira-iris.ru and
  # www.ira-iris.ru would otherwise keep two separate copies of a student's progress.
  # The query string (?k=...) is carried over by mod_rewrite.
  RewriteCond %{HTTP_HOST} !^www\.ira-iris\.ru$ [NC]
  RewriteRule ^ https://www.ira-iris.ru%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{ENV:HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.ira-iris.ru%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_authz_core.c>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Content-Type-Options "nosniff"

  # Pages are checked for a new version on every visit; a new lesson appears right away.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(mp3|webp)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # общий код платформы: имя меняется вместе с содержимым, поэтому хранить можно год
  <FilesMatch "^app-[0-9a-f]{12}\.(js|css|json)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # офлайн-режим и почтовый ящик — всегда свежие
  <FilesMatch "^(sw\.js|box\.php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
